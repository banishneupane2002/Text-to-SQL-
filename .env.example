# Banking Text-to-SQL Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

SECRET_KEY=your-secret-django-key-here
DEBUG=True

# Groq API Configuration (Get yours at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=auto

# Microsoft SQL Server (T-SQL) Connection
MSSQL_SERVER=.\SQLEXPRESS
MSSQL_DATABASE=AdventureWorks2022
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
MSSQL_TRUSTED_CONNECTION=yes

# SQLite Fallback Path (optional)
SQLITE_FALLBACK_PATH=path/to/financial.sqlite

